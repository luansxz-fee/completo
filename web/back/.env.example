# ===== MedSync API — copie para .env (NUNCA envie o .env para o GitHub) =====
NODE_ENV=production
PORT=3001

# MongoDB Atlas (ou local)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster.mongodb.net/medsync?retryWrites=true&w=majority

# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"   (mínimo 32 caracteres)
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Endereço(s) do site, separados por vírgula (CORS)
FRONTEND_URL=https://seu-site.vercel.app

# ---------- E-MAIL (verificação de conta, recuperação de senha, lembretes) ----------
# RECOMENDADO: Brevo (HTTPS, 300 e-mails/dia grátis, aceita remetente verificado, sem domínio próprio)
BREVO_API_KEY=
EMAIL_REMETENTE=MedSync <seu-email-verificado@gmail.com>
# Alternativas: RESEND_API_KEY=...  |  SMTP (EMAIL_HOST/EMAIL_PORT/EMAIL_USUARIO/EMAIL_SENHA)
# ATENÇÃO: o plano gratuito do Render bloqueia SMTP. Em desenvolvimento, sem nada configurado,
# o código aparece no log do servidor (EMAIL_PROVIDER=console).

# ---------- NOTIFICAÇÕES PUSH (navegador/PWA) ----------
# NÃO PRECISA CONFIGURAR NADA: o servidor gera as chaves sozinho na 1ª inicialização e as
# guarda no banco. Só defina as três linhas abaixo se quiser fixar chaves próprias.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:seu-email@exemplo.com

# ---------- LEMBRETES ----------
# Agendador interno (a cada 60 s). Em plano que "dorme", use também o gatilho externo abaixo.
SCHEDULER_ATIVO=true
# Segredo do gatilho externo:  GET https://SEU-BACKEND/api/interno/lembretes?segredo=ESTE_VALOR
CRON_SECRET=
# Minutos até alertar o cuidador / marcar a dose como perdida
ALERTA_CUIDADOR_MIN=30
TOLERANCIA_PERDIDA_MIN=120

# Confirmação de e-mail por código:
#   (vazio)      → obrigatória quando há provedor de e-mail configurado; SEM provedor é dispensada
#                  automaticamente (o cadastro nunca trava esperando um código que não chegaria)
#   obrigatoria  → sempre exige   |   dispensada → nunca exige
# VERIFICACAO_EMAIL=

# Somente em desenvolvimento local: devolve o código de verificação na resposta da API
# (só funciona com NODE_ENV=development). Nunca use em produção.
# EXPOR_CODIGO_DEV=true
